# ------------------------------------------
test-output/
reports/
*.exec
*.coverage
*.lcov

# Environment & config
# ------------------------------------------
.env
.env.local
*.properties.local
application-*.yml.local

# Dependencies & archives
# ------------------------------------------
*.jar
*.war
*.zip
*.tar.gz

